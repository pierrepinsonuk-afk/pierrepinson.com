```{=html}
<div class="pub-list" id="pub-list">
<% for (const item of items) { %>
<article class="pub" data-year="<%= item.year %>" data-themes="<%= item.themes %>" data-kind="<%= item.kind %>">
  <div class="pub-year"><%= item.year %></div>
  <div>
    <h3 class="pub-title"><% if (item.url || item.preprint) { %><a href="<%- item.url || item.preprint %>"><%= item.title %></a><% } else { %><%= item.title %><% } %></h3>
    <p class="pub-authors"><% const parts = String(item.authors).split("P. Pinson"); %><% parts.forEach((part, i) => { %><%- part %><% if (i < parts.length - 1) { %><strong>P. Pinson</strong><% } %><% }) %></p>
    <p class="pub-venue"><%= item.venue %></p>
    <p class="pub-links">
      <% if (item.url) { %><a href="<%- item.url %>">Publisher page</a><% } %>
      <% if (item.preprint) { %><a href="<%- item.preprint %>">Open preprint</a><% } %>
      <% if (item.status) { %><span class="pub-status"><%= item.status %></span><% } %>
    </p>
  </div>
</article>
<% } %>
</div>
```
